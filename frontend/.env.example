# SatQuery AI — frontend environment
#
# Leave everything unset for the normal setup: the app calls same-origin
# /api/v1 and /static, and Vite proxies both to the FastAPI backend
# (see vite.config.ts). That is what makes the UI work from a second machine
# on the LAN as well as from localhost.

# Point the browser directly at a backend on another host. Only set this when
# you are NOT serving the frontend through the Vite proxy — e.g. a static
# build hosted separately, or a tunnelled GPU box.
# VITE_API_BASE_URL=http://192.168.1.42:8000/api/v1

# Backend the dev-server proxy forwards to. Defaults to http://127.0.0.1:8000.
# Read by vite.config.ts at startup, not by the browser.
# SATQUERY_BACKEND=http://127.0.0.1:8000
